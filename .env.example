# Jinora Configuration Settings

# Database & Storage
DATABASE_URL=sqlite:///data/meta_ads.db
DOWNLOADS_DIR=downloads

# LLM Provider Configuration ('gemini' is the primary Free Tier provider)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_CHEAP=gemini-2.5-flash-lite

# API Keys (Never commit your real keys)
GEMINI_API_KEY=

# Target Discovery Markets
DEFAULT_COUNTRIES=PE,MX,CO,AR,CL,ES,US

# Scoring Weights (Must sum to 1.0)
SCORE_WEIGHT_CREATIVE=0.7
SCORE_WEIGHT_MARKET=0.3

# --- FASE 0.1: Gemini Free Tier & Quota Control ---
FREE_TIER_MODE=true
GEMINI_RPM=5
GEMINI_RPD=20
GEMINI_TPM=250000

# Optional separate RPD limits per model (check Google AI Studio Rate Limits)
GEMINI_RPD_MAIN=
GEMINI_RPD_CHEAP=

# Reserved daily requests for manual operations/tests
RESERVE_REQUESTS=2

# Batching Configurations
EVAL_BATCH_VIDEOS=3
EVAL_BATCH_STATICS=6
RELEVANCE_BATCH_SIZE=20

# Run filters & Video limits
FIRST_RUN_PRIORITY_ONLY=true
MAX_EVALS_PER_RUN=0
VIDEO_MAX_SECONDS_FOR_LLM=90
GEMINI_MEDIA_RESOLUTION=low
