# Jinora Configuration Settings

# Database & Storage
DATABASE_URL=sqlite:///data/meta_ads.db
DOWNLOADS_DIR=downloads

# LLM Provider Configuration ('gemini' is the primary Free Tier provider)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_MODEL_CHEAP=gemini-3.5-flash-lite

# API Keys (Never commit your real keys)
GEMINI_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
CLAUDE_BUDGET_USD=8.0
CLAUDE_MODEL_STATIC=claude-sonnet-5-5
CLAUDE_MAX_IMAGE_PX=1568

# Target Discovery Markets
DEFAULT_COUNTRIES=PE,MX,CO,AR,CL,ES,US

# Scoring Weights (Must sum to 1.0)
SCORE_WEIGHT_CREATIVE=0.7
SCORE_WEIGHT_MARKET=0.3

# --- FASE 0.1: Gemini Free Tier & Quota Control ---
FREE_TIER_MODE=true
GEMINI_RPM=5
GEMINI_RPD=20
GEMINI_TPM=250000

# Optional separate RPD limits per model (check Google AI Studio Rate Limits)
GEMINI_RPD_MAIN=
GEMINI_RPD_CHEAP=

# Reserved daily requests for manual operations/tests
RESERVE_REQUESTS=2

# Batching Configurations
EVAL_BATCH_VIDEOS=1
EVAL_BATCH_STATICS=1
RELEVANCE_BATCH_SIZE=20

# Run filters & Video limits
FIRST_RUN_PRIORITY_ONLY=false
MAX_EVALS_PER_RUN=0
VIDEO_MAX_SECONDS_FOR_LLM=0
GEMINI_MEDIA_RESOLUTION=medium
COLLECT_INACTIVE=false

# Progressive backoff delays in seconds with jitter for transient Gemini errors (503, 500, 429)
GEMINI_RETRY_DELAYS=5,15,45,120

# Preferred off-peak time window in America/Lima for running evaluation queue
EVAL_PREFERRED_HOURS=01:00-06:00
